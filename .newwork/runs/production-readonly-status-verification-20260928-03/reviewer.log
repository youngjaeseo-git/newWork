    23	LESSON_EFFECTS = {"supported", "inconclusive", "contradicted"}
    24	INTERNAL_PROJECTIONS = (".newwork/events.jsonl", ".newwork/STATE.yaml",
    25	                        ".newwork/FINDINGS.yaml", ".newwork/LESSONS.yaml")
    26	EXIT = {"ok": 0, "invalid_input": 2, "conflict": 10, "review_required": 11,
    27	        "ledger_corrupt": 12, "invalid_evidence": 13, "io_error": 14}
    28	RETRY_EVENTS = {"start": "session_started", "end": "session_ended", "finding": "finding_recorded",
    29	                "interrupt": "session_interrupted"}
    30	LIFECYCLE_EVENTS = {"session_started", "session_ended", "session_interrupted"}
