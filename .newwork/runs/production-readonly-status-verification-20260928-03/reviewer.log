    83	def git(root):
    84	    def run(*args):
    85	        result = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, check=True)
    86	        return result.stdout.strip()
    87	
    88	    excluded = [f":(exclude){name}" for name in (*INTERNAL_PROJECTIONS, ".newwork/.lock")]
    89	    tracked = subprocess.run(["git", "-C", str(root), "diff", "HEAD", "--binary", "--", ".",
    90	                              *excluded], capture_output=True, check=True).stdout
    91	    untracked = run("ls-files", "--others", "--exclude-standard", "--", ".", *excluded).splitlines()
    92	    fingerprint = hashlib.sha256(tracked)
    93	    for name in untracked:
    94	        path = root / name
    95	        fingerprint.update(name.encode("utf-8") + b"\0")
    96	        if path.is_file():
    97	            fingerprint.update(hashlib.sha256(path.read_bytes()).digest())
    98	    return {"branch": run("branch", "--show-current"), "head": run("rev-parse", "HEAD"),
    99	            "dirty": bool(tracked or untracked), "worktree_sha256": fingerprint.hexdigest()}
   100	
   101	
   102	def tree_identity(root, tree):
   103	    listing = subprocess.run(["git", "-C", str(root), "ls-tree", "-rz", "--full-tree", tree],
   104	                             capture_output=True, check=True).stdout
   105	    excluded = {name.encode("utf-8") for name in INTERNAL_PROJECTIONS}
   106	    fingerprint = hashlib.sha256()
   107	    for entry in listing.split(b"\0"):
   108	        if entry and entry.split(b"\t", 1)[1] not in excluded:
   109	            fingerprint.update(entry + b"\0")
   110	    return fingerprint.hexdigest()
   111	
   112	
   113	def accepted_tree_identity(root):
   114	    # A temporary index observes the complete worktree, including untracked files,
   115	    # without changing the user's staging area.
   116	    with tempfile.TemporaryDirectory() as directory:
   117	        environment = {**os.environ, "GIT_INDEX_FILE": str(Path(directory) / "index")}
   118	        def run(*args):
   119	            return subprocess.run(["git", "-C", str(root), *args], env=environment,
   120	                                  capture_output=True, text=True, check=True).stdout.strip()
   121	        run("read-tree", "HEAD")
   122	        run("add", "-A", "--", ".")
   123	        return tree_identity(root, run("write-tree"))
   124	
   125	
   126	def checkpoint_transition(root, events, recorded, current):
   127	    if recorded is None or current["branch"] != recorded["branch"] or not current["branch"]:
   128	        return False
   129	    acceptance = next((event for event in reversed(events) if event["type"] == "git_reconciled"
   130	                       and event["data"].get("accepted_change_identity")
   131	                       and event["data"]["git"] == recorded), None)
   132	    if acceptance is None or current["head"] == recorded["head"]:
   133	        return False
   134	    parents = subprocess.run(["git", "-C", str(root), "rev-list", "--parents", "-n", "1", "HEAD"],
   135	                             capture_output=True, text=True, check=True).stdout.split()
   136	    if len(parents) != 2 or parents[1] != recorded["head"]:
   137	        return False
   138	    if subprocess.run(["git", "-C", str(root), "status", "--porcelain=v1", "--untracked-files=all"],
   139	                      capture_output=True, check=True).stdout:
   140	        return False
   141	    if tree_identity(root, "HEAD") != acceptance["data"]["accepted_change_identity"]:
   142	        return False
   143	    for name in INTERNAL_PROJECTIONS:
   144	        committed = subprocess.run(["git", "-C", str(root), "show", f"HEAD:{name}"],
   145	                                   capture_output=True)
   146	        try:
   147	            current_bytes = (root / name).read_bytes()
   148	        except OSError:
   149	            return False
   150	        if committed.returncode or committed.stdout != current_bytes:
   151	            return False
   152	    return True
