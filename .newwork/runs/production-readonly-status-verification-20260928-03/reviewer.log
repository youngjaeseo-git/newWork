   183	def read_events(base):
   184	    path = base / "events.jsonl"
   185	    if not path.exists():
   186	        fail("invalid_input", "Memory Foundation not initialized; run init")
   187	    events = []
   188	    previous = "0" * 64
   189	    with path.open(encoding="utf-8") as handle:
   190	        for number, line in enumerate(handle, 1):
   191	            try:
   192	                event = json.loads(line)
   193	            except json.JSONDecodeError as exc:
   194	                fail("ledger_corrupt", f"invalid event line {number}: {exc}")
   195	            checksum = event.pop("hash", None)
   196	            if event.get("seq") != number or event.get("prev_hash") != previous or checksum != digest(event):
   197	                fail("ledger_corrupt", f"event chain mismatch at line {number}")
   198	            event["hash"] = checksum
   199	            events.append(event)
   200	            previous = checksum
   201	    if not events or events[0]["type"] != "initialized":
   202	        fail("ledger_corrupt", "event ledger has no initialization event")
   203	    return events
   204	
   205	
   206	def append(base, events, kind, data, fingerprint=None):
   207	    event = {"seq": len(events) + 1, "at": now(), "type": kind, "data": data,
   208	             "prev_hash": events[-1]["hash"] if events else "0" * 64}
   209	    if fingerprint:
   210	        event["request_fingerprint"] = fingerprint
   211	    event["hash"] = digest(event)
   212	    with (base / "events.jsonl").open("a", encoding="utf-8") as handle:
   213	        handle.write(canonical(event) + "\n")
   214	        handle.flush()
   215	        os.fsync(handle.fileno())
   216	    events.append(event)
