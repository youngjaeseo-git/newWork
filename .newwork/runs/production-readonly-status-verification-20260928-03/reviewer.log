    33	class MemoryFailure(Exception):
    34	    def __init__(self, status, message, **details):
    35	        super().__init__(message)
    36	        self.status, self.details = status, details
    37	
    38	
    39	def fail(status, message, **details):
    40	    raise MemoryFailure(status, message, **details)
    41	
    42	
    43	def reply(status="ok", **fields):
    44	    print(canonical({"status": status, **fields}))
    45	
    46	
    47	def request_key(command, data):
    48	    return digest({"command": command, "request": data})
    49	
    50	
    51	def retry(events, state, findings, command, data):
    52	    fingerprint = request_key(command, data)
    53	    for event in events:
    54	        if event.get("request_fingerprint") == fingerprint:
    55	            if event["type"] != RETRY_EVENTS[command]:
    56	                fail("ledger_corrupt", "request fingerprint belongs to another event")
    57	            expected_active = None if command in ("end", "interrupt") else data.get("session_id", data.get("id"))
    58	            latest_lifecycle = next((item for item in reversed(events) if item["type"] in LIFECYCLE_EVENTS), None)
    59	            current_valid = state["active_session"] == expected_active
    60	            if command in ("end", "interrupt"):
    61	                current_valid = current_valid and latest_lifecycle["seq"] == event["seq"]
    62	            if command == "finding":
    63	                current_valid = current_valid and findings["items"].get(data["id"]) == event["data"]
    64	            if not current_valid:
    65	                fail("conflict", "request was applied previously but its result is no longer current",
    66	                     active_session=state["active_session"])
    67	            return event, fingerprint
    68	    return None, fingerprint
