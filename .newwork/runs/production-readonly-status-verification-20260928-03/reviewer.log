   219	def project(events):
   220	    state = {"schema": SCHEMA, "event_seq": 0, "active_session": None, "next_start": "",
   221	             "open_tasks": {}, "pending_confirmations": {}, "last_git": None}
   222	    findings = {"schema": SCHEMA, "event_seq": 0, "items": {}}
   223	    lessons = {"schema": SCHEMA, "event_seq": 0, "items": {}}
   224	    for event in events:
   225	        data, kind = event["data"], event["type"]
   226	        state["event_seq"] = findings["event_seq"] = lessons["event_seq"] = event["seq"]
   227	        if kind == "session_started":
   228	            state["active_session"] = data["id"]
   229	            state["last_git"] = data["git"]
   230	        elif kind == "session_ended":
   231	            state["active_session"] = None
   232	            state["next_start"] = data["next_start"]
   233	            state["last_git"] = data["git"]
   234	        elif kind == "session_interrupted":
   235	            state["active_session"] = None
   236	        elif kind == "task_opened":
   237	            state["open_tasks"][data["id"]] = {**data, "open_event": event["seq"]}
   238	        elif kind == "task_closed":
   239	            state["open_tasks"].pop(data["id"], None)
   240	        elif kind == "git_reconciled":
