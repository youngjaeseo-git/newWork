   203	        proof.write_text(verifier_text, encoding="utf-8")
   204	        rel = evidence_path or f".newwork/runs/{run_id}/verifier.md"
   205	        proof_hash = hashlib.sha256(proof.read_bytes()).hexdigest()
   206	        result = {"schema_version": 1, "run_id": run_id, "task_id": task_id,
   207	                  "task_open_event": open_event if open_event is not None else self.state()["open_tasks"][task_id]["open_event"],
   208	                  "verdict": verdict, "evidence": [{"path": rel,
   209	                  "sha256": evidence_hash or proof_hash}],
   210	                  "verifier_artifact": {"path": f".newwork/runs/{run_id}/verifier.md", "sha256": proof_hash}}
   211	        path = folder / "verification-result.json"
   212	        path.write_text(json.dumps(result), encoding="utf-8")
   213	        return path.relative_to(self.repo).as_posix()
