   168	@contextmanager
   169	def locked(base, shared=False):
   170	    lock = base / ".lock"
   171	    if shared:
   172	        if not lock.is_file():
   173	            fail("invalid_input", "Memory Foundation not initialized; run init")
   174	        mode, operation = "rb", fcntl.LOCK_SH
   175	    else:
   176	        base.mkdir(exist_ok=True)
   177	        mode, operation = "a+b", fcntl.LOCK_EX
   178	    with lock.open(mode) as handle:
   179	        fcntl.flock(handle, operation)
   180	        yield
   181	
