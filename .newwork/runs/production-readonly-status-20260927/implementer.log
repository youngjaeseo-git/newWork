+    def test_status_uses_read_only_shared_lock_without_writing_memory(self):
+        self.call("init")
+        base = self.repo / ".newwork"
+        lock = base / ".lock"
+        observed = {path.name: path.read_bytes() for path in base.iterdir() if path.is_file()}
+        lock.chmod(0o444)
+        try:
