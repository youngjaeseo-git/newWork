   198	    def result(self, task_id="task-1", open_event=None, run_id="run-1", verdict="PASS",
   199	               evidence_path=None, evidence_hash=None, verifier_text="VERDICT: PASS\n"):
   200	        folder = self.repo / ".newwork/runs" / run_id
   201	        folder.mkdir(parents=True, exist_ok=True)
