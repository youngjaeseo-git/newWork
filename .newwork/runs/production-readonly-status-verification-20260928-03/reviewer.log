    71	def canonical(value):
    72	    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    73	
    74	
    75	def digest(value):
    76	    return hashlib.sha256(canonical(value).encode("utf-8")).hexdigest()
    77	
    78	
    79	def now():
    80	    return datetime.now(timezone.utc).isoformat(timespec="seconds")
