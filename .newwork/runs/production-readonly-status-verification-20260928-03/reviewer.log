   588	            append(base, events, "lesson_proposed", {"id": args.id, "scope": args.scope, "claim": args.claim,
   589	                                                     "source": source, "supporting": supporting,
   590	                                                     "contradictory": contradictory,
   591	                                                     "effect": {"status": args.effect, "note": args.effect_note}})
   592	        elif args.command == "lesson-decide":
   593	            require_session(state)
   594	            if not args.reason.strip():
   595	                fail("invalid_input", "lesson decision reason must be non-empty")
   596	            item = lessons["items"].get(args.id)
   597	            if item is None:
   598	                fail("invalid_input", "lesson id does not exist")
   599	            if args.action in {"approve", "reject"}:
   600	                if item["status"] != "candidate" or args.replacement:
   601	                    fail("conflict", "decision requires a candidate and no replacement id")
   602	                if args.action == "approve":
   603	                    if item["effect"]["status"] != "supported":
   604	                        fail("review_required", "effect is not supported; candidate preserved")
   605	                    require_fresh_lesson(root, item)
   606	                kind = "lesson_approved" if args.action == "approve" else "lesson_rejected"
   607	                append(base, events, kind, {"id": args.id, "reason": args.reason})
   608	            elif args.action == "withdraw":
   609	                if item["status"] != "approved" or args.replacement:
   610	                    fail("conflict", "withdrawal requires an approved lesson and no replacement id")
   611	                append(base, events, "lesson_withdrawn", {"id": args.id, "reason": args.reason})
   612	            elif args.action == "replace":
   613	                replacement = lessons["items"].get(args.replacement)
   614	                if item["status"] != "approved" or replacement is None or replacement["status"] != "candidate":
   615	                    fail("conflict", "replacement requires approved old and candidate new lessons")
   616	                if replacement["effect"]["status"] != "supported":
   617	                    fail("review_required", "replacement effect is not supported")
   618	                require_fresh_lesson(root, replacement)
   619	                append(base, events, "lesson_replaced", {"id": args.id, "replacement_id": args.replacement,
   620	                                                         "reason": args.reason})
   621	        else:
   622	            fail("invalid_input", "unsupported command")
   623	        projections(base, events)
