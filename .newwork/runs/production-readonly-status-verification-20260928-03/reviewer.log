   159	def root_for(path):
   160	    root = Path(path).resolve()
   161	    result = subprocess.run(["git", "-C", str(root), "rev-parse", "--show-toplevel"],
   162	                            capture_output=True, text=True, check=True)
   163	    if root != Path(result.stdout.strip()).resolve():
   164	        fail("invalid_input", "--root must be the Git repository root")
   165	    return root
