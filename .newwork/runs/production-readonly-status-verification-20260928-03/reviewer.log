   630	def main():
   631	    class JsonParser(argparse.ArgumentParser):
   632	        def error(self, message):
   633	            fail("invalid_input", message)
   634	
   635	    parser = JsonParser(description=__doc__)
   636	    parser.add_argument("--root", default=".")
   637	    sub = parser.add_subparsers(dest="command", required=True)
   638	    for name in ("init", "rebuild", "reconcile", "status", "accept-git", "start", "end", "interrupt", "request-confirmation",
   639	                 "resolve-confirmation", "finding", "open-task", "close-task", "lesson-propose", "lesson-decide",
   640	                 "lesson-check"):
   641	        cmd = sub.add_parser(name)
   642	        if name in ("start", "end", "interrupt", "request-confirmation", "resolve-confirmation", "finding", "open-task", "close-task", "lesson-propose", "lesson-decide", "lesson-check"):
   643	            cmd.add_argument("id")
   644	        if name == "end":
   645	            cmd.add_argument("--next-start", required=True)
   646	        if name == "accept-git":
   647	            cmd.add_argument("reason")
   648	        if name == "interrupt":
   649	            cmd.add_argument("reason")
   650	        if name == "request-confirmation":
   651	            cmd.add_argument("question")
   652	        if name == "resolve-confirmation":
   653	            cmd.add_argument("answer")
   654	        if name == "finding":
   655	            cmd.add_argument("claim")
   656	            cmd.add_argument("status", choices=sorted(STATUSES))
   657	            cmd.add_argument("--evidence", action="append", default=[])
   658	        if name == "open-task":
   659	            cmd.add_argument("title")
   660	        if name == "close-task":
   661	            cmd.add_argument("--result", required=True)
   662	        if name == "lesson-propose":
   663	            cmd.add_argument("claim")
   664	            cmd.add_argument("--scope", choices=["project"], default="project")
   665	            cmd.add_argument("--source", required=True)
   666	            cmd.add_argument("--support", action="append", default=[])
   667	            cmd.add_argument("--contradict", action="append", default=[])
   668	            cmd.add_argument("--effect", choices=sorted(LESSON_EFFECTS), required=True)
   669	            cmd.add_argument("--effect-note", required=True)
   670	        if name == "lesson-decide":
   671	            cmd.add_argument("action", choices=["approve", "reject", "withdraw", "replace"])
   672	            cmd.add_argument("--reason", required=True)
   673	            cmd.add_argument("--replacement")
   674	    try:
   675	        args = parser.parse_args()
   676	        return execute(args) or 0
   677	    except MemoryFailure as exc:
   678	        reply(exc.status, message=str(exc), **exc.details)
   679	        return EXIT[exc.status]
   680	    except (ValueError, KeyError, TypeError, AttributeError) as exc:
   681	        reply("ledger_corrupt", message=str(exc))
   682	        return EXIT["ledger_corrupt"]
   683	    except (OSError, subprocess.CalledProcessError) as exc:
   684	        reply("io_error", message=str(exc))
   685	        return EXIT["io_error"]
   686	    return 0
