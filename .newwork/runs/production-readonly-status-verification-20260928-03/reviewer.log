     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# ── 프로젝트 루트 기준으로 실행 ──────────────────────────────────────────────
     5	SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
     6	cd "$SCRIPT_DIR"
     7	
     8	# ── 환경 변수 로드 (.env 파일이 있으면 불러옴) ────────────────────────────────
     9	if [ -f ".env" ]; then
    10	  # shellcheck disable=SC2046
    11	  export $(grep -v '^#' .env | grep -v '^$' | xargs)
    12	fi
    13	
    14	# ── 필수 환경 변수 체크 ────────────────────────────────────────────────────────
    15	# 필요한 변수가 있으면 아래에 추가:
    16	# : "${MY_VAR:?MY_VAR is required. .env.example 을 참고하세요}"
    17	
    18	# ── 의존성 설치 (필요한 섹션만 주석 해제) ────────────────────────────────────
    19	# Node.js
    20	# if [ -f "package.json" ]; then
    21	#   echo "[setup] npm install..."
    22	#   npm install --silent
    23	# fi
    24	
    25	# Python
    26	# if [ -f "requirements.txt" ]; then
    27	#   echo "[setup] pip install..."
    28	#   pip install -r requirements.txt -q
    29	# fi
    30	
    31	# ── 실행 ──────────────────────────────────────────────────────────────────────
    32	case "${1:-}" in
    33	  loop-poc)
    34	    shift
    35	    exec "$SCRIPT_DIR/scripts/loop-agent-poc.sh" "$@"
    36	    ;;
    37	  memory)
    38	    shift
    39	    exec python3 "$SCRIPT_DIR/scripts/newwork-memory.py" --root "$SCRIPT_DIR" "$@"
    40	    ;;
    41	  test)
    42	    shift
    43	    "$SCRIPT_DIR/tests/test-loop-agent-poc.sh" "$@"
    44	    exec python3 "$SCRIPT_DIR/tests/test-newwork-memory.py"
    45	    ;;
    46	  "")
    47	    echo "run.sh: 실행 명령을 아래에 채워주세요."
    48	    echo '  PoC: ./run.sh loop-poc "할 일" [workspace]'
    49	    echo "  Memory: ./run.sh memory <init|start|end|reconcile|rebuild|...>"
    50	    echo "  테스트: ./run.sh test"
    51	    ;;
    52	  *)
    53	    echo "run.sh: 알 수 없는 명령: $1" >&2
    54	    echo "  지원: loop-poc, memory, test" >&2
    55	    exit 2
    56	    ;;
