  FAILURE_STAGE="implementer"
  FAILURE_REASON="implementer did not report IMPLEMENTATION: COMPLETE on attempt $ATTEMPT"
  echo "[loop-poc] implementer did not report completion; stopping before review" >&2
  exit 1

