   650	    def test_legacy_acceptance_without_identity_is_not_retroactive(self):
   651	        self.checkpoint_ready()
   652	        ledger = self.repo / ".newwork/events.jsonl"
   653	        lines = ledger.read_text(encoding="utf-8").splitlines()
   654	        last = json.loads(lines[-1])
   655	        last["data"].pop("accepted_change_identity")
   656	        last.pop("hash")
   657	        last["hash"] = hashlib.sha256(json.dumps(last, ensure_ascii=False, sort_keys=True,
   658	                                                  separators=(",", ":")).encode("utf-8")).hexdigest()
   659	        lines[-1] = json.dumps(last, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
   660	        ledger.write_text("\n".join(lines) + "\n", encoding="utf-8")
   661	        self.git("add", "-A")
   662	        self.git("commit", "-qm", "legacy acceptance")
   663	        self.assert_reconcile_status("review_required")
