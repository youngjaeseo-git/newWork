   225	        self.call("open-task", "task-1", "Verify")
   226	        self.assert_close_rejected("conflict", self.result(run_id="json-pass-verifier-fail",
   227	                                                           verifier_text="Details\nVERDICT: FAIL\n"))
   228	        self.assert_close_rejected("conflict", self.result(run_id="json-fail-verifier-pass", verdict="FAIL"))
   229	        tampered = self.result(run_id="tampered-hash")
   230	        verifier = self.repo / ".newwork/runs/tampered-hash/verifier.md"
   231	        verifier.write_text("Details changed\nVERDICT: PASS\n", encoding="utf-8")
   232	        body = json.loads((self.repo / tampered).read_text(encoding="utf-8"))
   233	        body["evidence"][0]["sha256"] = hashlib.sha256(verifier.read_bytes()).hexdigest()
   234	        (self.repo / tampered).write_text(json.dumps(body), encoding="utf-8")
   235	        self.assert_close_rejected("invalid_evidence", tampered)
   236	        other = self.result(run_id="other-run")
   237	        wrong_run = self.result(run_id="wrong-run")
   238	        body = json.loads((self.repo / wrong_run).read_text(encoding="utf-8"))
   239	        body["verifier_artifact"] = json.loads((self.repo / other).read_text(encoding="utf-8"))["verifier_artifact"]
   240	        (self.repo / wrong_run).write_text(json.dumps(body), encoding="utf-8")
   241	        self.assert_close_rejected("invalid_evidence", wrong_run)
   242	        escaped = self.result(run_id="escaped")
   243	        body = json.loads((self.repo / escaped).read_text(encoding="utf-8"))
   244	        body["verifier_artifact"]["path"] = ".newwork/runs/escaped/../../DECISIONS.md"
   245	        (self.repo / escaped).write_text(json.dumps(body), encoding="utf-8")
   246	        self.assert_close_rejected("invalid_evidence", escaped)
   247	        symlinked = self.result(run_id="symlinked")
   248	        alias = self.repo / ".newwork/runs/symlinked/alias.md"
   249	        alias.symlink_to(self.repo / ".newwork/runs/other-run/verifier.md")
   250	        body = json.loads((self.repo / symlinked).read_text(encoding="utf-8"))
   251	        body["verifier_artifact"]["path"] = ".newwork/runs/symlinked/alias.md"
   252	        (self.repo / symlinked).write_text(json.dumps(body), encoding="utf-8")
   253	        self.assert_close_rejected("invalid_evidence", symlinked)
   254	        omitted = self.result(run_id="omitted-verifier")
   255	        body = json.loads((self.repo / omitted).read_text(encoding="utf-8"))
   256	        body.pop("verifier_artifact")
   257	        (self.repo / omitted).write_text(json.dumps(body), encoding="utf-8")
   258	        self.assert_close_rejected("invalid_evidence", omitted)
   259	        missing = self.result(run_id="missing-verifier")
   260	        body = json.loads((self.repo / missing).read_text(encoding="utf-8"))
   261	        separate_proof = self.repo / ".newwork/runs/missing-verifier/reviewer.md"
   262	        separate_proof.write_text("Review passed\n", encoding="utf-8")
   263	        body["evidence"] = [{"path": ".newwork/runs/missing-verifier/reviewer.md",
   264	                             "sha256": hashlib.sha256(separate_proof.read_bytes()).hexdigest()}]
   265	        (self.repo / missing).write_text(json.dumps(body), encoding="utf-8")
   266	        (self.repo / ".newwork/runs/missing-verifier/verifier.md").unlink()
   267	        self.assert_close_rejected("invalid_evidence", missing)
   268	        good = self.result(run_id="valid-verifier", verifier_text="Details\n\nVERDICT: PASS\n\n")
