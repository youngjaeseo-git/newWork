    64	    def test_project_lesson_live_reuse_requires_current_references(self):
    65	        self.lesson_fixture()
    66	        contrary = self.repo / ".newwork/runs/contrary/log.txt"
    67	        contrary.parent.mkdir(parents=True)
    68	        contrary.write_text("Counterexample\n", encoding="utf-8")
    69	        self.propose_lesson("source", "supported", "--contradict", ".newwork/runs/contrary/log.txt")
    70	        self.call("lesson-decide", "source", "approve", "--reason", "Reviewed")
    71	        self.assertEqual(self.lessons()["source"]["reuse_policy"], "live_freshness_check_required")
    72	        self.assertTrue(self.check_lesson("source")["reusable"])
    73	        for path in (self.repo / "retrospective.md", self.repo / "README.md", contrary):
    74	            original = path.read_bytes()
    75	            path.write_bytes(original + b"changed\n")
    76	            result = self.check_lesson("source")
    77	            self.assertFalse(result["reusable"])
    78	            self.assertEqual(result["status"], "review_required")
    79	            self.assertEqual(self.lessons()["source"]["status"], "approved")
    80	            path.write_bytes(original)
    81	        contrary.unlink()
    82	        self.assertFalse(self.check_lesson("source")["reusable"])
    83	        contrary.write_text("Counterexample\n", encoding="utf-8")
    84	        self.assertTrue(self.check_lesson("source")["reusable"])
